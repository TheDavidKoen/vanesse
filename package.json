{
  "name": "vanesse",
  "displayName": "Vanessë",
  "description": "A bold dark theme of gold, violet and cyan on a deep night sky, with matching cloud badge file icons.",
  "version": "0.1.0",
  "publisher": "thedavidkoen",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24",
    "vscode": "^1.90.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/TheDavidKoen/vanesse.git"
  },
  "bugs": {
    "url": "https://github.com/TheDavidKoen/vanesse/issues"
  },
  "homepage": "https://github.com/TheDavidKoen/vanesse#readme",
  "categories": [
    "Themes"
  ],
  "keywords": [
    "vanesse",
    "theme",
    "dark",
    "dark theme",
    "color theme",
    "icon theme",
    "file icons",
    "violet",
    "colorful"
  ],
  "galleryBanner": {
    "color": "#06050F",
    "theme": "dark"
  },
  "contributes": {
    "themes": [
      {
        "label": "Vanessë",
        "uiTheme": "vs-dark",
        "path": "./themes/vanesse-color-theme.json"
      }
    ],
    "iconThemes": [
      {
        "id": "vanesse-icons",
        "label": "Vanessë Icons",
        "path": "./themes/vanesse-icon-theme.json"
      }
    ]
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "build:watch": "node --watch-path=src --watch-path=scripts scripts/build.ts",
    "typecheck": "tsc",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "node --test \"src/**/*.test.ts\"",
    "check:package": "node scripts/check-package.ts",
    "package": "vsce package --no-dependencies",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm test && pnpm run build && pnpm run check:package",
    "vscode:prepublish": "node scripts/build.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@types/node": "^24.13.4",
    "@vscode/vsce": "^3.9.2",
    "ovsx": "^1.2.0",
    "simple-icons": "^16.31.0",
    "typescript": "^7.0.2"
  }
}
